# Copy to config.env and replace every path/image placeholder.  Do not add
# API keys, tokens, passwords, credentials, model revisions, or plan values.
# Model/tokenizer revisions and all vLLM controls are read only from the
# separately approved generation plan.
KT_DATA_DIR=/ABSOLUTE/PATH/TO/miracl-ko-data
KT_CONTROL_DIR=./control
KT_OUTPUT_DIR=./output
KT_MODEL_CACHE_DIR=/ABSOLUTE/PATH/TO/huggingface-cache
KT_VLLM_IMAGE=REPLACE_WITH_APPROVED_LOCAL_IMAGE_REFERENCE
KT_CONTAINER_DIGEST=sha256:REPLACE_WITH_APPROVED_64_HEX_DIGEST
KT_VLLM_HOST=127.0.0.1
KT_VLLM_PORT=8000
