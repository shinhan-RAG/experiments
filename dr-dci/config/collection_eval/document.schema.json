{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinhan-rag.local/schemas/collection-document-v1",
  "title": "Collection document",
  "type": "object",
  "required": [
    "schema_version",
    "collection_id",
    "document_id",
    "text",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "shinhan.collection-document.v1"},
    "collection_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
