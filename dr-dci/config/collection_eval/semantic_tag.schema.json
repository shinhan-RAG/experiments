{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinhan-rag.local/schemas/collection-semantic-tag-v1",
  "title": "QA-independent element semantic tag",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tag_id",
    "collection_id",
    "document_id",
    "element_id",
    "tags",
    "generation"
  ],
  "properties": {
    "schema_version": {"const": "shinhan.collection-semantic-tag.v1"},
    "tag_id": {"type": "string", "minLength": 1},
    "collection_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "element_id": {"type": "string", "minLength": 1},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id",
        "revision",
        "prompt_sha256",
        "input_fields",
        "qa_access",
        "qrel_access",
        "gold_access"
      ],
      "properties": {
        "generator_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "element_text",
              "element_type",
              "document_title",
              "document_metadata"
            ]
          }
        },
        "qa_access": {"const": false},
        "qrel_access": {"const": false},
        "gold_access": {"const": false}
      }
    }
  }
}
