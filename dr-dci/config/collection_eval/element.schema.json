{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinhan-rag.local/schemas/collection-element-v1",
  "title": "Collection element",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "element_id",
    "document_id",
    "element_type",
    "ordinal",
    "text",
    "source_location"
  ],
  "properties": {
    "schema_version": {"const": "shinhan.collection-element.v1"},
    "collection_id": {"type": "string", "minLength": 1},
    "element_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "element_type": {"type": "string", "minLength": 1},
    "ordinal": {"type": "integer", "minimum": 0},
    "text": {"type": "string", "minLength": 1},
    "source_location": {"$ref": "qa.schema.json#/$defs/sourceLocation"}
  }
}
