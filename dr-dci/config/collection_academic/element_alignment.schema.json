{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shinhan-rag.local/schemas/collection-element-alignment-v1",
  "title": "Collection element alignment record",
  "description": "Element-to-document, element-to-constructed-document-range, and element-to-chunk mapping. Ranges use the constructed document text basis and are never PDF/PPTX source offsets; source_location stays explicitly unavailable in this stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "document_id",
    "element_id",
    "ordinal",
    "document_range",
    "chunk_memberships",
    "source_location"
  ],
  "properties": {
    "schema_version": {"const": "shinhan.collection-element-alignment.v1"},
    "collection_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "element_id": {"type": "string", "minLength": 1},
    "ordinal": {"type": "integer", "minimum": 0},
    "document_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "method", "char_start", "char_end"],
      "properties": {
        "status": {"const": "verified"},
        "basis": {"const": "constructed_document_text"},
        "method": {"const": "ordered_concatenation"},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 1}
      }
    },
    "chunk_memberships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "char_start", "char_end"],
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "char_start": {"type": "integer", "minimum": 0},
          "char_end": {"type": "integer", "minimum": 1}
        }
      }
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "char_start", "char_end"],
      "properties": {
        "status": {"const": "unavailable"},
        "basis": {"const": "unavailable"},
        "char_start": {"type": "null"},
        "char_end": {"type": "null"}
      }
    }
  }
}
