{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "miracl_ko_flat_l1_assignment_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["outputs"],
  "properties": {
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_index", "label_id", "score", "status"],
        "properties": {
          "request_index": {"const": 0},
          "label_id": {
            "enum": [
              "science",
              "history",
              "geography",
              "arts_culture",
              "sports",
              "politics",
              "technology",
              "biology",
              "society",
              "other",
              "unknown"
            ]
          },
          "score": {"enum": [0.0, 1.0]},
          "status": {"enum": ["assigned", "unknown"]}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "unknown"}}},
            "then": {
              "properties": {
                "label_id": {"const": "unknown"},
                "score": {"const": 0.0}
              }
            },
            "else": {
              "properties": {
                "label_id": {
                  "enum": [
                    "science",
                    "history",
                    "geography",
                    "arts_culture",
                    "sports",
                    "politics",
                    "technology",
                    "biology",
                    "society",
                    "other"
                  ]
                },
                "score": {"const": 1.0}
              }
            }
          }
        ]
      }
    }
  }
}
