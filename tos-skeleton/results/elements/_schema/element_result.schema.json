{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tos-skeleton/results/elements/_schema/element_result.schema.json",
  "title": "Element-level retrieval result",
  "description": "문서를 자른 단위로 검색한 결과. 널 대조 필드는 필수이며 미측정이면 null.",
  "type": "object",
  "required": [
    "config_id",
    "date",
    "author",
    "repro",
    "population",
    "config",
    "metrics",
    "nulls",
    "limitations"
  ],
  "properties": {
    "config_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(_[a-z0-9-]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string"
    },
    "experiment": {
      "type": "string"
    },
    "repro": {
      "type": "object",
      "required": [
        "doc_sha256",
        "gold_sha",
        "code_commit",
        "two_pass_sha"
      ],
      "properties": {
        "doc_sha256": {
          "type": "string"
        },
        "gold_sha": {
          "type": "string"
        },
        "code_commit": {
          "type": "string"
        },
        "two_pass_sha": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "population": {
      "type": "object",
      "required": [
        "name",
        "n"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "R@1": {
          "type": [
            "number",
            "null"
          ]
        },
        "R@5": {
          "type": [
            "number",
            "null"
          ]
        },
        "R@10": {
          "type": [
            "number",
            "null"
          ]
        },
        "R@20": {
          "type": [
            "number",
            "null"
          ]
        },
        "R@50": {
          "type": [
            "number",
            "null"
          ]
        },
        "R@100": {
          "type": [
            "number",
            "null"
          ]
        },
        "MRR@10": {
          "type": [
            "number",
            "null"
          ]
        },
        "L_star_median": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "nulls": {
      "type": "object",
      "required": [
        "query_shuffle",
        "constant_dummy",
        "shuffled_tag",
        "random_vector"
      ],
      "properties": {
        "query_shuffle": {
          "$ref": "#/$defs/nullEntry"
        },
        "constant_dummy": {
          "$ref": "#/$defs/nullEntry"
        },
        "shuffled_tag": {
          "$ref": "#/$defs/nullEntry"
        },
        "random_vector": {
          "$ref": "#/$defs/nullEntry"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "config": {
      "type": "object",
      "required": [
        "channel",
        "channel_params",
        "schema",
        "split"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "bm25",
            "dense",
            "rrf",
            "rerank",
            "hybrid",
            "other"
          ]
        },
        "channel_params": {
          "type": "object"
        },
        "schema": {
          "type": "object",
          "required": [
            "name",
            "fields"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extractor": {
              "type": "string"
            }
          }
        },
        "split": {
          "type": "object",
          "required": [
            "name",
            "n_elements"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "n_elements": {
              "type": "integer"
            },
            "median_chars": {
              "type": "number"
            },
            "rule": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nullEntry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "seeds": {
              "type": "integer"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}