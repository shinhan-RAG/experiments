{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["audit_policy", "decisions"],
  "additionalProperties": false,
  "properties": {
    "audit_policy": {"type": "string"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["qid", "decision", "review", "reason", "ops", "evidence_notes"],
        "additionalProperties": false,
        "properties": {
          "qid": {"type": "string"},
          "decision": {"enum": ["pass", "fix", "exclude"]},
          "review": {"type": "string"},
          "reason": {"type": "string"},
          "ops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["op", "group", "jo", "c0", "c1", "members", "evidence_role"],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {"required": ["op"],
                         "properties": {"op": {"const": "add_required_group"}}},
                  "then": {"properties": {"group": {"type": "null"},
                                          "members": {"minItems": 1}}}
                },
                {
                  "if": {"required": ["op"],
                         "properties": {"op": {"enum": ["add_members",
                                                        "replace_group_members"]}}},
                  "then": {"properties": {"group": {"type": "integer", "minimum": 0},
                                          "members": {"minItems": 1}}}
                },
                {
                  "if": {"required": ["op"],
                         "properties": {"op": {"const": "replace_span"}}},
                  "then": {"properties": {"group": {"type": "integer", "minimum": 0}}}
                }
              ],
              "properties": {
                "op": {"enum": ["add_members", "replace_group_members", "replace_span",
                                "add_required_group"]},
                "group": {"type": ["integer", "null"], "minimum": 0},
                "jo": {"type": ["string", "null"]},
                "c0": {"type": ["integer", "null"]},
                "c1": {"type": ["integer", "null"]},
                "members": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["jo", "c0", "c1", "evidence_role"],
                    "additionalProperties": false,
                    "properties": {
                      "jo": {"type": "string"},
                      "c0": {"type": "integer"},
                      "c1": {"type": "integer"},
                      "evidence_role": {"type": "string"}
                    }
                  }
                },
                "evidence_role": {"type": ["string", "null"]}
              }
            }
          },
          "evidence_notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
